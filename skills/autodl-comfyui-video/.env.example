# Copy this file to a private path such as %USERPROFILE%\.config\autodl.env.
# Never commit the copied file or replace the placeholder with a real token here.
AUTODL_TOKEN=<your AutoDL ComfyUI token>

# Optional: defaults to https://autodl.art (HTTPS 443).
# Use AUTODL_API_BASE instead if that name is already part of your environment.
AUTODL_BASE_URL=https://autodl.art
